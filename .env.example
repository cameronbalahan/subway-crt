# Optional MTA API Key (MTA public subway GTFS-RT feeds do not strictly require a key, but setting one is supported)
# MTA_API_KEY="your_mta_api_key_here"

# Optional Feed URL Overrides for custom endpoints or proxying
# MTA_FEED_L="https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-l"
# MTA_FEED_ALERTS="https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fsubway-alerts"
# MTA_FEED_G="https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-g"
# MTA_FEED_JZ="https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-jz"

# Server Port (defaults to 3000)
PORT="3000"

# Set HEADLESS="true" when running as a headless daemon without interactive terminal attached
# HEADLESS="false"
